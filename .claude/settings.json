{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run greenproof check --hook claude",
            "timeout": 2760
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run greenproof session-start --hook claude"
          }
        ]
      }
    ]
  }
}
