{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx greenproof@0.2.0 check --hook codex",
            "timeout": 3600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "uvx greenproof@0.2.0 session-start --hook codex"
          }
        ]
      }
    ]
  }
}
