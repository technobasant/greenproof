{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx greenproof@0.5.0 check --hook claude",
            "timeout": 3600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "uvx greenproof@0.5.0 session-start --hook claude"
          }
        ]
      }
    ]
  }
}
